<article class="section article-main bg-cream" style="--pt: 64; --pb: 96;">
  <div class="page-width page-width--narrow">
    <header class="page-hero page-hero--center">
      <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
      <h1 class="h1 page-hero__title">{{ article.title | escape }}</h1>
    </header>

    {%- if article.image -%}
      <div class="article__image">
        {%- assign hero_alt = article.image.alt | default: article.title -%}
        {{ article.image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 820px, 92vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt, class: 'article__img' }}
      </div>
    {%- endif -%}

    <div class="prose card card--prose rte">
      {{ article.content }}
    </div>

    <p class="article__back">
      <a class="btn btn--secondary" href="{{ blog.url }}">
        {% render 'icon', name: 'arrow-left' %}
        <span>{{ 'blogs.back' | t }}</span>
      </a>
    </p>

    {%- if blog.comments_enabled? -%}
      <section class="comments card card--prose" aria-labelledby="CommentsTitle">
        <h2 class="h3" id="CommentsTitle">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>
        {%- for comment in article.comments -%}
          <div class="comment">
            <p class="comment__author">{{ comment.author | escape }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
            <div class="rte">{{ comment.content }}</div>
          </div>
        {%- endfor -%}

        {%- form 'new_comment', article, class: 'comment-form' -%}
          <h3 class="h4">{{ 'blogs.comments.form_title' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status">
              {%- if blog.moderated? -%}{{ 'blogs.comments.success_moderated' | t }}{%- else -%}{{ 'blogs.comments.success' | t }}{%- endif -%}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="form-grid">
            <div class="field field--half">
              <label class="field__label" for="CommentAuthor">{{ 'blogs.comments.name' | t }} <span class="field__required" aria-hidden="true">*</span></label>
              <input class="field__input" id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required aria-required="true">
            </div>
            <div class="field field--half">
              <label class="field__label" for="CommentEmail">{{ 'blogs.comments.email' | t }} <span class="field__required" aria-hidden="true">*</span></label>
              <input class="field__input" id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required aria-required="true">
            </div>
            <div class="field field--full">
              <label class="field__label" for="CommentBody">{{ 'blogs.comments.message' | t }} <span class="field__required" aria-hidden="true">*</span></label>
              <textarea class="field__input field__input--textarea" id="CommentBody" name="comment[body]" rows="5" required aria-required="true">{{ form.body }}</textarea>
            </div>
          </div>
          {%- if blog.moderated? -%}
            <p class="form-actions__note">{{ 'blogs.comments.moderated' | t }}</p>
          {%- endif -%}
          <button type="submit" class="btn btn--primary">{{ 'blogs.comments.post' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
