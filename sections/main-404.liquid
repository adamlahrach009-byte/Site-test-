{%- assign s = section.settings -%}
{%- capture contact_url -%}{% render 'contact-url', link: s.button_2_link %}{%- endcapture -%}

<section class="section not-found bg-{{ s.background }}" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  {% render 'section-decor', decor: true, wave: false, variant: 'hero' %}
  <div class="page-width not-found__grid">
    <div class="not-found__visual" aria-hidden="true">
      <figure class="polaroid polaroid--square not-found__polaroid" style="--rotate: -4deg;">
        <span class="polaroid__tape polaroid__tape--yellow polaroid__tape--center"></span>
        <div class="polaroid__media not-found__media">
          <span class="not-found__code">404</span>
          <svg class="not-found__blob" viewBox="0 0 200 200" focusable="false"><path d="M54.1,-71.2C68.4,-62.3,77.3,-44.7,80.6,-26.9C83.9,-9.1,81.6,8.9,74.6,24.4C67.6,39.9,55.9,52.9,41.8,61.9C27.7,70.9,11.2,75.9,-5.6,77.6C-22.4,79.3,-39.5,77.7,-52.6,68.9C-65.7,60.1,-74.8,44.1,-78.3,27.4C-81.8,10.7,-79.7,-6.7,-73.1,-21.6C-66.5,-36.5,-55.4,-48.9,-42.2,-58.1C-29,-67.3,-14.5,-73.3,2.4,-76.6C19.3,-79.9,39.8,-80.1,54.1,-71.2Z" transform="translate(100 100)"/></svg>
        </div>
        <figcaption class="polaroid__caption">{{ s.caption | escape }}</figcaption>
      </figure>
      <figure class="polaroid polaroid--square not-found__polaroid not-found__polaroid--back" style="--rotate: 7deg;">
        <div class="polaroid__media">{% render 'placeholder', icon: 'camera' %}</div>
      </figure>
    </div>

    <div class="not-found__content">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow hero-anim" style="--d: 0;">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="h1 hl hero-anim" style="--d: 1;">{{ s.heading }}</h1>
      {%- if s.text != blank -%}
        <div class="rte not-found__text hero-anim" style="--d: 2;">{{ s.text }}</div>
      {%- endif -%}
      <div class="hero__actions hero-anim" style="--d: 3;">
        <a class="btn btn--primary btn--lg" href="{{ routes.root_url }}">
          {% render 'icon', name: 'home' %}
          {%- assign home_label = s.button_1_label -%}
          {%- if home_label == blank -%}
            {%- assign home_label = 'general.back_home' | t -%}
          {%- endif -%}
          <span>{{ home_label | escape }}</span>
        </a>
        {%- if s.button_2_label != blank -%}
          <a class="btn btn--secondary btn--lg" href="{{ contact_url | strip }}">
            <span>{{ s.button_2_label | escape }}</span>
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page 404",
  "tag": "div",
  "class": "section-404",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Erreur 404"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Cette page joue à <em>cache-cache</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Comme un tout-petit bien caché pendant la séance photo, la page que vous cherchez reste introuvable. Pas d'inquiétude : voici de quoi retrouver votre chemin.</p>"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Légende du polaroïd",
      "default": "Introuvable…"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Bouton principal",
      "default": "Retour à l'accueil"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Bouton secondaire",
      "default": "Proposer une date"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Lien du bouton secondaire",
      "info": "Laissez vide pour utiliser la page « Proposer une date »."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "warm", "label": "Crème chaud" },
        { "value": "mint", "label": "Menthe" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement en haut",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement en bas",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 112
    }
  ]
}
{% endschema %}
