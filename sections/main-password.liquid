<section class="password-main">
  {% render 'section-decor', decor: true, wave: false, variant: 'hero' %}
  <div class="password-card card">
    {% render 'logo', text: section.settings.brand_name, class: 'password-card__logo' %}
    {%- if section.settings.heading != blank -%}
      <h1 class="h2 hl password-card__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p class="password-card__message">{{ shop.password_message }}</p>
    {%- elsif section.settings.text != blank -%}
      <div class="password-card__message rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if settings.contact_phone != blank -%}
      <a class="contact-chip password-card__phone" href="{% render 'phone-href' %}">
        <span class="icon-bubble">{% render 'icon', name: 'phone' %}</span>
        <span>
          <span class="contact-chip__label">{{ section.settings.phone_label | escape }}</span>
          <span class="contact-chip__value">{{ settings.contact_phone }}</span>
        </span>
      </a>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-form' -%}
      <details class="password-card__access"{% if form.errors %} open{% endif %}>
        <summary class="password-card__toggle">
          {% render 'icon', name: 'lock' %}
          <span>{{ 'password.enter' | t }}</span>
        </summary>
        {%- if form.errors -%}
          <p class="form-status form-status--error" role="alert" id="PasswordError">{{ 'password.error' | t }}</p>
        {%- endif -%}
        <label class="field__label" for="Password">{{ 'password.password' | t }}</label>
        <div class="password-form__row">
          <input
            class="field__input"
            id="Password"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}
          >
          <button type="submit" class="btn btn--primary">{{ 'password.submit' | t }}</button>
        </div>
        <p class="password-card__admin">
          {{ 'password.admin' | t }} <a href="/admin" rel="nofollow">{{ 'password.admin_link' | t }}</a>
        </p>
      </details>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nom",
      "default": "Quick photo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Notre site arrive <em>très bientôt</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "info": "Affiché si aucun message n'est défini dans les préférences de la boutique.",
      "default": "<p>Photographe pour les crèches. Gratuit pour la crèche, et une partie des ventes lui est reversée.</p>"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Texte au-dessus du téléphone",
      "default": "Une question ? Appelez-nous"
    }
  ]
}
{% endschema %}
