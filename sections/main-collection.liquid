{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="section collection-main bg-cream" style="--pt: 64; --pb: 96;">
    <div class="page-width">
      <header class="page-hero page-hero--center">
        <p class="eyebrow">{{ 'collections.products' | t: count: collection.products_count }}</p>
        <h1 class="h1 page-hero__title">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="page-hero__text rte">{{ collection.description }}</div>
        {%- endif -%}
      </header>

      {%- if collection.products.size > 0 -%}
        <ul class="product-grid" role="list">
          {%- for product in collection.products -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="empty-state">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
