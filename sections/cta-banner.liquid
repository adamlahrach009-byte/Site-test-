{%- assign s = section.settings -%}
{%- capture button_url -%}{% render 'contact-url', link: s.button_link %}{%- endcapture -%}

<section class="section cta bg-{{ s.background }}{% if s.wave %} has-wave{% endif %}" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};" data-cta-banner>
  {% render 'section-decor', decor: false, wave: s.wave %}
  <div class="page-width">
    <div class="cta__card cta__card--{{ s.card_color }}" data-reveal>
      <div class="cta__decor" aria-hidden="true">
        <svg class="cta__blob cta__blob--1" viewBox="0 0 200 200" focusable="false"><path d="M47.6,-62.4C60.8,-53.4,70.1,-38.7,74.6,-22.9C79.1,-7.1,78.8,9.8,72.6,24.1C66.4,38.4,54.3,50.1,40.5,58.5C26.7,66.9,11.2,72,-4.9,74.4C-21,76.8,-37.7,76.5,-50.7,68.5C-63.7,60.5,-73,44.8,-77.2,28.1C-81.4,11.4,-80.5,-6.3,-74.2,-21.4C-67.9,-36.5,-56.2,-49,-42.6,-58.1C-29,-67.2,-14.5,-72.9,1,-74.3C16.5,-75.7,34.4,-71.4,47.6,-62.4Z" transform="translate(100 100)"/></svg>
        <svg class="cta__blob cta__blob--2" viewBox="0 0 200 200" focusable="false"><path d="M54.1,-71.2C68.4,-62.3,77.3,-44.7,80.6,-26.9C83.9,-9.1,81.6,8.9,74.6,24.4C67.6,39.9,55.9,52.9,41.8,61.9C27.7,70.9,11.2,75.9,-5.6,77.6C-22.4,79.3,-39.5,77.7,-52.6,68.9C-65.7,60.1,-74.8,44.1,-78.3,27.4C-81.8,10.7,-79.7,-6.7,-73.1,-21.6C-66.5,-36.5,-55.4,-48.9,-42.2,-58.1C-29,-67.3,-14.5,-73.3,2.4,-76.6C19.3,-79.9,39.8,-80.1,54.1,-71.2Z" transform="translate(100 100)"/></svg>
        <svg class="cta__star" viewBox="0 0 48 48" focusable="false"><path d="M24 4c1.6 9.3 5.2 14.4 16 16-10.8 1.6-14.4 6.7-16 16-1.6-9.3-5.2-14.4-16-16 10.8-1.6 14.4-6.7 16-16Z"/></svg>
      </div>

      <div class="cta__content">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow cta__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="h2 cta__title hl">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="cta__text rte">{{ s.text }}</div>
        {%- endif -%}
        <div class="cta__actions">
          {%- if s.button_label != blank -%}
            <a class="btn btn--cta btn--lg" href="{{ button_url | strip }}">
              {% render 'icon', name: 'calendar-heart' %}
              <span>{{ s.button_label | escape }}</span>
            </a>
          {%- endif -%}
          {%- if s.show_phone and settings.contact_phone != blank -%}
            <a class="cta__phone" href="{% render 'phone-href' %}">
              <span class="cta__phone-icon">{% render 'icon', name: 'phone' %}</span>
              <span>
                <span class="cta__phone-label">{{ s.phone_label | escape }}</span>
                <span class="cta__phone-number">{{ settings.contact_phone }}</span>
              </span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Appel à l'action",
  "tag": "div",
  "class": "section-cta",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Gratuit pour la crèche"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Envie d'une séance photo dans votre crèche ?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Proposez-nous une date : nous revenons vers vous pour organiser la séance ensemble.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Proposer une date"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Laissez vide pour utiliser la page « Proposer une date »."
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Afficher le téléphone",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Texte au-dessus du téléphone",
      "default": "Ou appelez-nous"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "select",
      "id": "card_color",
      "label": "Couleur de l'encadré",
      "default": "green",
      "options": [
        { "value": "green", "label": "Vert" },
        { "value": "mint", "label": "Menthe" },
        { "value": "accent", "label": "Jaune doux" }
      ]
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond de la section",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "warm", "label": "Crème chaud" },
        { "value": "mint", "label": "Menthe" },
        { "value": "white", "label": "Blanc" }
      ]
    },
    {
      "type": "checkbox",
      "id": "wave",
      "label": "Bord supérieur ondulé",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement en haut",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement en bas",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "Appel à l'action"
    }
  ]
}
{% endschema %}
