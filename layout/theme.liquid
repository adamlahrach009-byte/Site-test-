<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_header }}">
    <meta name="format-detection" content="telephone=no">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- unless settings.heading_font.system? and settings.body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- liquid
      assign seo_title = page_title | default: shop.name
      if current_tags
        assign seo_tags = current_tags | join: ', '
        assign seo_tagged = 'general.tagged' | t: tags: seo_tags
        assign seo_title = seo_title | append: ' – ' | append: seo_tagged
      endif
      if current_page != 1
        assign seo_page = 'general.page' | t: page: current_page
        assign seo_title = seo_title | append: ' – ' | append: seo_page
      endif
      unless seo_title contains shop.name
        assign seo_title = seo_title | append: ' – ' | append: shop.name
      endunless
      assign seo_description = page_description | default: settings.business_description
    -%}
    <title>{{ seo_title }}</title>
    {%- if seo_description != blank %}
      <meta name="description" content="{{ seo_description | strip_html | strip_newlines | escape }}">
    {%- endif %}

    {% render 'meta-tags', seo_title: seo_title, seo_description: seo_description %}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      {%- if settings.animations_reveal %}{% unless request.design_mode %}
      if ('IntersectionObserver' in window && window.matchMedia && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
      {%- endunless %}{% endif %}
    </script>

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- unless settings.heading_font.system? %}
      {{ settings.heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless %}
    {%- unless settings.body_font.system? %}
      {{ settings.body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- if settings.structured_data and request.page_type == 'index' -%}
      {% render 'structured-data' %}
    {%- endif -%}
  </head>

  <body class="template-{{ request.page_type | handle }}{% if template.suffix != blank %} template-{{ request.page_type | handle }}--{{ template.suffix | handle }}{% endif %}{% unless settings.animations_decor %} no-decor-motion{% endunless %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- unless template.suffix == 'contact' -%}
      {% render 'floating-cta' %}
    {%- endunless -%}

    {% render 'lightbox' %}
  </body>
</html>
