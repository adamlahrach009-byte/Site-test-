{%- comment -%}
  Placeholder élégant affiché lorsqu'aucune image n'est choisie.
  Accepte :
  - class {String} : classe supplémentaire (facultatif)
  - icon {String} : icône centrale (facultatif, « camera » par défaut)
{%- endcomment -%}
{%- assign placeholder_icon = icon | default: 'camera' -%}
<div class="placeholder{% if class %} {{ class }}{% endif %}" aria-hidden="true">
  <svg class="placeholder__blob" viewBox="0 0 200 200" focusable="false"><path d="M47.6,-62.4C60.8,-53.4,70.1,-38.7,74.6,-22.9C79.1,-7.1,78.8,9.8,72.6,24.1C66.4,38.4,54.3,50.1,40.5,58.5C26.7,66.9,11.2,72,-4.9,74.4C-21,76.8,-37.7,76.5,-50.7,68.5C-63.7,60.5,-73,44.8,-77.2,28.1C-81.4,11.4,-80.5,-6.3,-74.2,-21.4C-67.9,-36.5,-56.2,-49,-42.6,-58.1C-29,-67.2,-14.5,-72.9,1,-74.3C16.5,-75.7,34.4,-71.4,47.6,-62.4Z" transform="translate(100 100)"/></svg>
  <span class="placeholder__icon">{% render 'icon', name: placeholder_icon %}</span>
</div>
