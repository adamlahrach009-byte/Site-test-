      <path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c7 0 10 8 10 8a13.2 13.2 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.5 13.5 0 0 0 2 12s3 8 10 8a9.7 9.7 0 0 0 5.39-1.61"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/><path d="m2 2 20 20"/>
    {%- when 'file-check' -%}
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>
    {%- when 'user-check' -%}
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m16 11 2 2 4-4"/>
    {%- when 'trash' -%}
      <path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6M14 11v6"/>
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
    {%- when 'check-circle' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/>
    {%- when 'star' -%}
      <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z"/>
    {%- when 'tree' -%}
      <path d="M12 2.5 7 9h3l-4 6h5v5.5h2V15h5l-4-6h3Z"/>
    {%- when 'egg' -%}
      <path d="M12 21.5c-3.9 0-7-2.9-7-7C5 10 8.3 2.5 12 2.5S19 10 19 14.5c0 4.1-3.1 7-7 7Z"/><path d="m5.4 12.6 2.2 1.5 2.2-1.5 2.2 1.5 2.2-1.5 2.2 1.5 2.2-1.5"/>
    {%- when 'ornament' -%}
      <circle cx="12" cy="14.5" r="7"/><path d="M10 7.6V5.5h4v2.1"/><path d="M12 5.5V3"/><path d="M5.3 12.6c2 1.3 4.3 2 6.7 2s4.7-.7 6.7-2"/>
    {%- when 'image' -%}
      <rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
    {%- when 'images' -%}
      <rect x="7" y="7" width="14" height="14" rx="2.5"/><path d="M17 3H5.5A2.5 2.5 0 0 0 3 5.5V17"/><path d="m21 17-2.6-2.6a1.8 1.8 0 0 0-2.6 0L10 20"/><circle cx="12.5" cy="12" r="1.5"/>
    {%- when 'home' -%}
      <path d="M3 10.5 12 3l9 7.5"/><path d="M5 9v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M10 21v-6h4v6"/>
    {%- when 'moon' -%}
      <path d="M20.5 13.3A8.5 8.5 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8Z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'package' -%}
      <path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>
    {%- when 'message' -%}
      <path d="M21 12a8.5 8.5 0 0 1-12.3 7.6L3.5 21l1.4-5A8.5 8.5 0 1 1 21 12Z"/>
    {%- when 'phone' -%}
      <path d="M21.5 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.6 4.2 2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L7.6 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3.5 7.5 8.5 6 8.5-6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M19 12H5"/><path d="m11 6-6 6 6 6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18M6 6l12 12"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'expand' -%}
      <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'cart' -%}
      <circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M2.5 3h2.6l2.5 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.5L22 7.5H6.2"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>
    {%- when 'facebook' -%}
      <path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5.5v4H8v7h4v-7h3l1-4h-4V7.5a1 1 0 0 1 1-1h2Z"/>
    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/>
  {%- endcase -%}
</svg>
{%- endif -%}
