{%- comment -%}
  Bibliothèque d'icônes SVG (trait arrondi, 24 × 24).
  Accepte :
  - name {String} : nom de l'icône
  - class {String} : classe supplémentaire (facultatif)
{%- endcomment -%}
{%- if name == 'quote' -%}
  <svg class="icon icon--quote{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" width="40" height="32" viewBox="0 0 40 32" fill="currentColor"><path d="M9.6 32C4 32 0 27.7 0 21.4 0 11 7.4 3 17.3 0l1.6 4.2C12.6 6.7 9 11 8.6 15.4c.6-.2 1.4-.3 2.2-.3 4.6 0 8.1 3.4 8.1 8.3 0 5-4 8.6-9.3 8.6Zm21 0C25 32 21 27.7 21 21.4 21 11 28.4 3 38.3 0l1.6 4.2C33.6 6.7 30 11 29.6 15.4c.6-.2 1.4-.3 2.2-.3 4.6 0 8.1 3.4 8.1 8.3 0 5-4 8.6-9.3 8.6Z"/></svg>
{%- else -%}
<svg class="icon icon--{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4.5" rx="1.2"/><path d="M12 8v13"/><path d="M19 12.5V19a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6.5"/><path d="M7.6 8a2.6 2.6 0 0 1 0-5.2C10.4 2.8 12 8 12 8s1.6-5.2 4.4-5.2a2.6 2.6 0 0 1 0 5.2"/>
    {%- when 'hand-heart' -%}
      <path d="M11 14h2a2 2 0 0 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 15 6 6"/><path d="M19.5 8.5c.7-.7 1.5-1.6 1.5-2.7A2.7 2.7 0 0 0 16 4a2.8 2.8 0 0 0-5 1.8c0 1.2.8 2 1.5 2.8L16 12Z"/>
    {%- when 'sparkles' -%}
      <path d="M11 3.5 12.9 8.6 18 10.5l-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9Z"/><path d="M18.5 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8Z"/><path d="M5 2.5v3M3.5 4h3"/>
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="3"/><path d="M16 3v4M8 3v4M3 10h18"/>
    {%- when 'calendar-heart' -%}
      <rect x="3" y="5" width="18" height="16" rx="3"/><path d="M16 3v4M8 3v4M3 10h18"/><path d="M12 18.4 9.9 16.3a1.45 1.45 0 0 1 2.1-2 1.45 1.45 0 0 1 2.1 2Z"/>
    {%- when 'camera' -%}
      <path d="M14.5 4h-5L7.5 7H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2.5Z"/><circle cx="12" cy="13" r="3.5"/>
    {%- when 'users' -%}
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    {%- when 'smile' -%}
      <circle cx="12" cy="12" r="9"/><path d="M8.5 14.5s1.3 2 3.5 2 3.5-2 3.5-2"/><path d="M9 9.5h.01M15 9.5h.01"/>
    {%- when 'heart' -%}
      <path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 1 1 12 6a5 5 0 1 1 7.5 6.6Z"/>
    {%- when 'shield' -%}
      <path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z"/>
    {%- when 'shield-check' -%}
      <path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'lock' -%}
      <rect x="4" y="11" width="16" height="10" rx="2.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
