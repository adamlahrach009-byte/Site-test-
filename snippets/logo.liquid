{%- comment -%}
  Logo du site : image choisie dans l'éditeur ou logo texte avec pictogramme.
  Accepte :
  - logo {Image} : image du logo (facultatif)
  - logo_width {Number} : largeur de l'image en px
  - text {String} : nom affiché (logo texte)
  - class {String}
{%- endcomment -%}
{%- liquid
  assign logo_text = text | default: shop.name
  assign logo_width = logo_width | default: 150
-%}
<a href="{{ routes.root_url }}" class="logo{% if class %} {{ class }}{% endif %}" aria-label="{{ 'accessibility.logo_home' | t: shop: logo_text }}">
  {%- if logo != blank -%}
    {%- liquid
      assign logo_alt = logo.alt | default: logo_text
      assign logo_width_2x = logo_width | times: 2
      assign logo_widths = logo_width | append: ', ' | append: logo_width_2x
      assign logo_sizes = logo_width | append: 'px'
      assign logo_style = 'width: ' | append: logo_width | append: 'px;'
    -%}
    {{ logo | image_url: width: logo_width_2x | image_tag: widths: logo_widths, sizes: logo_sizes, alt: logo_alt, class: 'logo__img', style: logo_style, loading: 'eager' }}
  {%- else -%}
    <span class="logo__mark" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="40" height="40" focusable="false">
        <rect width="40" height="40" rx="13" fill="var(--color-primary)"/>
        <rect x="14.5" y="10" width="9" height="5" rx="2.2" fill="#fff"/>
        <rect x="8" y="13" width="24" height="17" rx="5.5" fill="#fff"/>
        <circle cx="20" cy="21.5" r="5.4" fill="var(--color-primary)"/>
        <circle cx="20" cy="21.5" r="2.4" fill="#fff"/>
        <circle cx="31" cy="9" r="3.6" fill="var(--color-accent)"/>
      </svg>
    </span>
    {%- liquid
      assign words = logo_text | split: ' '
      assign first_word = words | first
      assign rest = logo_text | remove_first: first_word | strip
    -%}
    <span class="logo__text">{{ first_word }}{% if rest != blank %} <span class="logo__accent">{{ rest }}</span>{% endif %}</span>
  {%- endif -%}
</a>
