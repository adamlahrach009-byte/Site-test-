{%- layout none -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_header }}">
    <meta name="robots" content="noindex">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless settings.heading_font.system? and settings.body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency | strip_html -%}
    <title>{{ 'gift_cards.value' | t: value: formatted_initial_value }}</title>

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main id="MainContent" class="gift-card section bg-cream" style="--pt: 64; --pb: 64;">
      {% render 'section-decor', decor: true, wave: false, variant: 'hero' %}
      <div class="page-width page-width--narrow">
        <div class="gift-card__card card card--prose">
          <p class="eyebrow">{{ shop.name | escape }}</p>
          <h1 class="h2 gift-card__title">{{ 'gift_cards.title' | t }}</h1>
          <p class="gift-card__value">{{ 'gift_cards.value' | t: value: formatted_initial_value }}</p>

          {%- if gift_card.expired -%}
            <p class="badge badge--soft">{{ 'gift_cards.expired' | t }}</p>
          {%- elsif gift_card.enabled == false -%}
            <p class="badge badge--soft">{{ 'gift_cards.disabled' | t }}</p>
          {%- elsif gift_card.expires_on -%}
            {%- assign gift_card_expiry_date = gift_card.expires_on | date: '%d/%m/%Y' -%}
            <p class="badge badge--accent">{{ 'gift_cards.expires_on' | t: date: gift_card_expiry_date }}</p>
          {%- endif -%}

          {%- if gift_card.balance != gift_card.initial_value -%}
            {%- assign gift_card_balance = gift_card.balance | money -%}
            <p>{{ 'gift_cards.balance' | t: balance: gift_card_balance }}</p>
          {%- endif -%}

          <div class="gift-card__code-wrap">
            <p class="field__label">{{ 'gift_cards.code' | t }}</p>
            <p class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
            <button type="button" class="btn btn--secondary btn--sm" data-copy="{{ gift_card.code | format_code }}" data-copied="{{ 'gift_cards.copied' | t }}">{{ 'gift_cards.copy' | t }}</button>
          </div>

          <div class="gift-card__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" role="img" aria-label="{{ 'gift_cards.qr_image' | t }}"></div>

          {%- if gift_card.pass_url -%}
            <p>
              <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
                <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.apple_wallet' | t }}" loading="lazy">
              </a>
            </p>
          {%- endif -%}

          <div class="gift-card__actions">
            <a class="btn btn--primary" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.shop' | t }}</a>
            <button type="button" class="btn btn--secondary" onclick="window.print();">{{ 'gift_cards.print' | t }}</button>
          </div>
        </div>
      </div>
    </main>

    <script>
      window.addEventListener('load', function () {
        var qr = document.getElementById('QrCode');
        if (qr && window.QRCode) {
          new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, imageAltText: qr.getAttribute('aria-label') });
        }
        var copy = document.querySelector('[data-copy]');
        if (copy && navigator.clipboard) {
          copy.addEventListener('click', function () {
            navigator.clipboard.writeText(copy.dataset.copy).then(function () {
              copy.textContent = copy.dataset.copied;
            });
          });
        }
      });
    </script>
  </body>
</html>
